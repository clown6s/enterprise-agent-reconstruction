# ---- 模型 API Key ----
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_EMBEDDING_MODEL=
EMBEDDING_DIM=4096

# ---- Milvus配置 ----
MILVUS_HOST=
MILVUS_PORT=
MILVUS_ROOT_USER=
MILVUS_PASSWORD=
MILVUS_DB=
MILVUS_COLLECTION=document_chunks

# ---- Mysql配置 ----
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=
MYSQL_ROOT_PASSWORD=

# ---- Redis配置  ----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ---- Elasticsearch配置 ----
CERT_FINGERPRINT=
ES_HOST=https://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=document_chunks

# ---- 飞书 ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
