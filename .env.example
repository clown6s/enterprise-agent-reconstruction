# ---- 模型 API Key ----
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
SILICONFLOW_EMBEDDING_MODEL=
SILICONFLOW_RERANK_MODEL=
EMBEDDING_DIM=4096

# ---- Milvus配置 ----
MILVUS_HOST=
MILVUS_PORT=
MILVUS_ROOT_USER=
MILVUS_PASSWORD=
MILVUS_DB=
MILVUS_COLLECTION=document_chunks

# ---- Mysql配置 ----
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DB=
MYSQL_ROOT_PASSWORD=

# ---- Redis配置  ----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ---- Elasticsearch配置 ----
CERT_FINGERPRINT=
ES_HOST=https://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=document_chunks

# ---- Elasticsearch 日志索引（可选；未配置则日志保留 stdout） ----
ES_LOG_URL=
ES_LOG_USERNAME=
ES_LOG_PASSWORD=
ES_LOG_INDEX_PREFIX=enterprise-agent-logs
ES_LOG_CERT_FINGERPRINT=

# ---- OpenTelemetry ----
OTEL_SERVICE_NAME=enterprise-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# ---- 飞书 Chat 渠道（可选；不配置不影响主服务） ----
FEISHU_ENABLED=false
FEISHU_TENANT_ID=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_HTTP_TIMEOUT=10
FEISHU_EVENT_RETRY_MAX=3
FEISHU_MESSAGE_DEDUPE_TTL=86400
FEISHU_GROUP_REQUIRE_MENTION=true
FEISHU_ALLOW_SOP_ACTION=false
FEISHU_CARD_VERSION=1
FEISHU_ALERT_WEBHOOK_URL=

# ---- 日志 ----
# dev/prod：dev 彩色可读，prod 输出 JSON（便于采集）
ENV=dev
# DEBUG/INFO/WARNING/ERROR
LOG_LEVEL=INFO

# ---- 检索 ----
# 每路（Milvus 向量 / ES 全文）召回多少候选；送到 rerank 的候选数
RECALL_K=100
RERANK_K=100
TOP_K=20

# ---- Chat MySQL storage identity ----
CHAT_STORAGE=mysql

# ---- 认证 Token 有效期（秒） ----
# access_token 7 天，refresh_token 90 天
AUTH_ACCESS_TTL=604800
AUTH_REFRESH_TTL=7776000
AUTH_TOKEN_LENGTH=32

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=你的Grafana管理员密码